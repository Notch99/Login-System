         * context.getSource().getServer().getPlayerManager().getPlayer(targetPlayerName
         * );
         * if (onlinePlayer != null) {
         * targetUUID = onlinePlayer.getUuid();
         * LOGGER.info("Found online player: " + targetPlayerName + " -> " +
